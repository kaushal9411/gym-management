# @gym-saas/api — copy to .env for local development
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database & cache (docker-compose services)
# Host port 5433 (not 5432) — avoids clashing with a native PostgreSQL
# install some machines already have running on the default port.
DATABASE_URL=postgresql://gym:gym@localhost:5433/gym_saas?schema=public
REDIS_URL=redis://localhost:6379

# AES-256 key for encrypting tenant-supplied secrets at rest (currently: a
# tenant's own AI provider API key). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Auth — RS256 keypair, base64-encoded PEM (avoids .env newline escaping issues).
# Generate locally with: node scripts/generate-jwt-keys.js
# Real keys live in AWS Secrets Manager/KMS in staging & production.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=fitcloud
JWT_AUDIENCE=fitcloud-tenant-app

# Platform domains & subdomain resolution
PLATFORM_DOMAIN=fitcloud.local
CORS_ORIGINS=http://fitcloud.local,http://admin.fitcloud.local,http://localhost:3001,http://localhost:3002

# Mail (mailpit in dev — see docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM_NAME=FitCloud
MAIL_FROM_ADDRESS=no-reply@fitcloud.local

# Providers (notification-ready placeholders — not required for auth to function)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Razorpay (Member Payments online-payment flow — Finance module). Test-mode keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Business Assistant (modules/ai-assistant) — provider is fully swappable,
# never hardcoded. AI_PROVIDER=openrouter is the free default: create a free
# key at https://openrouter.ai/keys and most :free-suffixed models cost
# nothing. To switch provider, change AI_PROVIDER + AI_MODEL + AI_API_KEY only
# — no code changes. AI_BASE_URL overrides the provider's default endpoint
# (required for azure-openai; useful for a self-hosted ollama at a non-default
# host). ollama needs no AI_API_KEY.
# NOTE: OpenRouter's free-model lineup changes over time — if AI_MODEL 404s
# ("no longer available for free"), check https://openrouter.ai/models?max_price=0
# for a current one and swap it in (a "reasoning" model can return empty
# content once max_tokens is spent on reasoning before an answer — prefer a
# plain instruct model like the current default).
AI_PROVIDER=openrouter
AI_MODEL=inclusionai/ling-3.0-flash:free
AI_API_KEY=
AI_BASE_URL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Password / lockout policy
BCRYPT_SALT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Logging
LOG_LEVEL=debug

# Error tracking / APM (optional — unset means fully disabled, zero overhead).
# Point at a real Sentry.io project DSN in production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Object storage (optional — unset means uploads stay as base64 data-URLs in
# Postgres, today's behavior). `docker compose up minio minio-init` for local dev;
# point at real AWS S3/Cloudflare R2/DigitalOcean Spaces in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fitcloud-uploads
S3_ACCESS_KEY_ID=gymminio
S3_SECRET_ACCESS_KEY=gymminio123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=http://localhost:9000/fitcloud-uploads
