// ════════════════════════════════════════════════════════════════════
// gym-saas-platform — Prisma schema
//
// Covers: authentication/authorization (Prompt 5), SaaS onboarding + tenant
// provisioning (Prompt 7), subscription & billing (Prompt 8), and the Super
// Admin portal (Prompt 9) — a completely separate authority plane (its own
// AdminUser/AdminRole/AdminPermission catalog, its own JWT audience) from
// tenant users, since gym owners must never be able to authenticate into
// the admin portal. Gym OPERATIONS modules (member/trainer/attendance
// management) remain out of scope and will extend this schema later.
//
// Conventions (docs/architecture/ARCHITECTURE.md §5 + coding-guidelines):
//   • UUID primary keys, snake_case tables via @@map
//   • every tenant-scoped table carries tenant_id (+ composite indexes)
//   • soft deletes (deleted_at) on business entities
//   • RLS policies for tenant tables are added in a follow-up raw-SQL
//     migration (see prisma/migrations/*_enable_row_level_security)
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum OtpPurpose {
  LOGIN_MFA
  EMAIL_VERIFICATION
  TWO_FACTOR

  @@map("otp_purpose")
}

enum OtpChannel {
  EMAIL
  SMS

  @@map("otp_channel")
}

/// Trial → Active → (Renewal Due) PAST_DUE → GRACE → SUSPENDED → back to
/// ACTIVE on reactivation, or CANCELED / EXPIRED as terminal states. GRACE,
/// SUSPENDED and EXPIRED were added in Prompt 8 (billing); PAST_DUE/CANCELED
/// already existed from Prompt 7 and keep their original meaning.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentGatewayProvider {
  STRIPE
  RAZORPAY
  PAYPAL

  @@map("payment_gateway_provider")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE

  @@map("invoice_status")
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  TRIAL_EXTENSION

  @@map("coupon_type")
}

enum CouponScope {
  ONE_TIME
  RECURRING
  REFERRAL

  @@map("coupon_scope")
}

enum SubscriptionHistoryAction {
  CREATED
  UPGRADED
  DOWNGRADED
  RENEWED
  CANCELLED
  REACTIVATED
  SUSPENDED
  EXPIRED
  TRIAL_STARTED
  TRIAL_ENDED

  @@map("subscription_history_action")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

enum DomainType {
  SUBDOMAIN
  CUSTOM

  @@map("domain_type")
}

// ── Platform: tenants ────────────────────────────────────────────────────

/// The gym business. Resolved on every request from the subdomain —
/// never supplied by the client.
model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  slug                  String       @unique @db.VarChar(40)
  name                  String       @db.VarChar(120)
  status                TenantStatus @default(TRIAL)
  trialEndsAt           DateTime?    @map("trial_ends_at")
  /// End of the PAST_DUE grace window; past this, subscription is hard-expired.
  subscriptionExpiresAt DateTime?    @map("subscription_expires_at")
  suspendedAt           DateTime?    @map("suspended_at")
  maintenanceMode       Boolean      @default(false) @map("maintenance_mode")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  settings              TenantSettings?
  branding              TenantBranding?
  profile               TenantProfile?
  invoiceSettings       TenantInvoiceSettings?
  limits                TenantLimit?
  users                 User[]
  roles                 Role[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordReset[]
  emailVerifications    EmailVerification[]
  otpCodes              OtpCode[]
  loginHistory          LoginHistory[]
  userSessions          UserSession[]
  auditLogs             AuditLog[]
  domains               TenantDomain[]
  branches              Branch[]
  modules               TenantModule[]
  usage                 TenantUsage[]
  subscriptions         Subscription[]
  subscriptionHistory   SubscriptionHistory[]
  billingAddress        BillingAddress?
  paymentMethods        PaymentMethod[]
  payments              Payment[]
  invoices              Invoice[]
  couponRedemptions     CouponRedemption[]
  supportTickets        SupportTicket[]
  notifications         TenantNotification[]
  userPermissions       UserPermission[]
  userBranches          UserBranch[]
  userInvitations       UserInvitation[]
  staffProfiles         StaffProfile[]
  membershipPlans       MembershipPlan[]
  members               Member[]
  memberships           Membership[]
  membershipFreezes     MembershipFreeze[]
  memberDocuments       MemberDocument[]
  attendances           Attendance[]
  exercises             Exercise[]
  workoutPlans          WorkoutPlan[]
  workoutPlanExercises  WorkoutPlanExercise[]
  memberWorkoutPlans    MemberWorkoutPlan[]
  memberWorkoutProgress MemberWorkoutProgress[]
  foods                 Food[]
  dietPlans             DietPlan[]
  dietPlanMeals         DietPlanMeal[]
  memberDietPlans       MemberDietPlan[]
  memberDietDailyLogs   MemberDietDailyLog[]
  memberInvoices        MemberInvoice[]
  memberInvoiceItems    MemberInvoiceItem[]
  memberPayments        MemberPayment[]
  memberPaymentRefunds  MemberPaymentRefund[]
  incomeEntries         Income[]
  expenses              Expense[]
  scheduledReports      ScheduledReport[]
  tenantAnnouncements   TenantAnnouncement[]
  notificationTemplates NotificationTemplate[]

  @@map("tenants")
}

/// Per-tenant branding & preferences — drives email templates and the
/// tenant-web portal theme (kept in lockstep with the frontend TenantBranding type).
enum MeasurementUnit {
  METRIC
  IMPERIAL

  @@map("measurement_unit")
}

model TenantSettings {
  id                        String          @id @default(uuid()) @db.Uuid
  tenantId                  String          @unique @map("tenant_id") @db.Uuid
  /// { primaryColor, primaryForeground, logoUrl?, welcomeMessage }
  branding                  Json            @default("{}")
  timezone                  String          @default("UTC") @db.VarChar(64)
  currency                  String          @default("USD") @db.Char(3)
  locale                    String          @default("en") @db.VarChar(10)
  emailFromName             String?         @map("email_from_name") @db.VarChar(120)
  emailFromAddress          String?         @map("email_from_address") @db.VarChar(255)
  /// Business Settings module (Prompt 12) — regional/display preferences.
  /// Symbol is stored (not derived) so a tenant can override the default for
  /// their currency code (e.g. "Fr" vs "CHF").
  currencySymbol            String          @default("$") @map("currency_symbol") @db.VarChar(8)
  dateFormat                String          @default("MM/DD/YYYY") @map("date_format") @db.VarChar(20)
  timeFormat                String          @default("12h") @map("time_format") @db.VarChar(4)
  /// 0 = Sunday .. 6 = Saturday.
  weekStartDay              Int             @default(0) @map("week_start_day")
  measurementUnit           MeasurementUnit @default(METRIC) @map("measurement_unit")
  /// Notification Preferences (tenant-wide channel defaults — distinct from
  /// each user's own notificationPreferences on the User model).
  emailNotificationsEnabled Boolean         @default(true) @map("email_notifications_enabled")
  pushNotificationsEnabled  Boolean         @default(true) @map("push_notifications_enabled")
  /// SMS is configuration-only — no provider is wired up (matches the
  /// no-op Pusher / sandboxed-gateway pattern elsewhere): this just
  /// records intent + provider config for when a real SMS provider ships.
  smsNotificationsEnabled   Boolean         @default(false) @map("sms_notifications_enabled")
  smsProviderConfig         Json?           @map("sms_provider_config")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ── Identity ─────────────────────────────────────────────────────────────

/// A staff or member account, always scoped to exactly one tenant.
/// The same email may exist in different tenants (different gyms).
model User {
  id                       String     @id @default(uuid()) @db.Uuid
  tenantId                 String     @map("tenant_id") @db.Uuid
  name                     String     @db.VarChar(120)
  email                    String     @db.VarChar(255)
  phone                    String?    @db.VarChar(20)
  passwordHash             String     @map("password_hash")
  status                   UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt          DateTime?  @map("email_verified_at")
  failedLoginAttempts      Int        @default(0) @map("failed_login_attempts")
  lockedUntil              DateTime?  @map("locked_until")
  lastLoginAt              DateTime?  @map("last_login_at")
  passwordChangedAt        DateTime?  @map("password_changed_at")
  mfaEnabled               Boolean    @default(false) @map("mfa_enabled")
  mfaSecret                String?    @map("mfa_secret")
  /// IAM profile fields (Prompt 11). Avatar is a URL or small data-URL —
  /// swap for object storage when a storage provider is configured.
  avatarUrl                String?    @map("avatar_url")
  emergencyContactName     String?    @map("emergency_contact_name") @db.VarChar(120)
  emergencyContactPhone    String?    @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelation String?    @map("emergency_contact_relation") @db.VarChar(60)
  /// Per-user notification preference toggles, e.g. {"email_billing": true}.
  notificationPreferences  Json?      @map("notification_preferences")
  /// Bumped on every role/permission change for this user — part of the
  /// permission-cache key AND the JWT claim, so edits invalidate cached
  /// permission sets. Persisted here (not Redis-only) so it survives
  /// eviction/restarts.
  permissionVersion        Int        @default(1) @map("permission_version")
  /// Branch access: true = every branch (default; owners/managers), false =
  /// only the branches listed in user_branches.
  allBranches              Boolean    @default(true) @map("all_branches")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")
  deletedAt                DateTime?  @map("deleted_at")

  tenant                       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles                    UserRole[]
  refreshTokens                RefreshToken[]
  passwordResets               PasswordReset[]
  emailVerifications           EmailVerification[]
  otpCodes                     OtpCode[]
  loginHistory                 LoginHistory[]
  sessions                     UserSession[]
  auditLogsAsActor             AuditLog[]            @relation("AuditActor")
  userPermissions              UserPermission[]
  userBranches                 UserBranch[]
  sentInvitations              UserInvitation[]      @relation("InvitationInviter")
  staffProfile                 StaffProfile?
  trainerFor                   Member[]              @relation("MemberTrainer")
  attendanceCheckIns           Attendance[]          @relation("AttendanceCheckedInBy")
  attendanceCheckOuts          Attendance[]          @relation("AttendanceCheckedOutBy")
  workoutPlansAsTrainer        WorkoutPlan[]         @relation("WorkoutPlanTrainer")
  memberWorkoutPlansAssignedBy MemberWorkoutPlan[]   @relation("MemberWorkoutPlanAssignedBy")
  dietPlansAsTrainer           DietPlan[]            @relation("DietPlanTrainer")
  memberDietPlansAssignedBy    MemberDietPlan[]      @relation("MemberDietPlanAssignedBy")
  memberPaymentsRecorded       MemberPayment[]       @relation("MemberPaymentRecordedBy")
  memberPaymentRefundsIssued   MemberPaymentRefund[] @relation("MemberPaymentRefundedBy")
  incomeEntriesRecorded        Income[]              @relation("IncomeRecordedBy")
  expensesRecorded             Expense[]             @relation("ExpenseRecordedBy")
  scheduledReportsCreated      ScheduledReport[]     @relation("ScheduledReportCreatedBy")
  tenantAnnouncementsCreated   TenantAnnouncement[]  @relation("TenantAnnouncementCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  /// Covers the default "browse all staff/users" sort (createdAt desc) and
  /// the created-at range filter on the user list — neither had a usable
  /// composite index before (Prompt 32 perf pass).
  @@index([tenantId, createdAt])
  /// Covers the "inactive staff" report filter (lastLoginAt range) — had no
  /// index at all before (Prompt 32 perf pass).
  @@index([tenantId, lastLoginAt])
  @@map("users")
}

/// System roles have tenantId = null (shared catalog: SUPER_ADMIN, OWNER,
/// MANAGER, TRAINER, RECEPTIONIST, MEMBER). Custom roles (Enterprise,
/// future) are tenant-scoped.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(60)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  /// Hierarchy weight — higher wins when displaying a user's primary role.
  priority    Int      @default(0)
  /// Pre-selected role for new invitations/users in this tenant.
  isDefault   Boolean  @default(false) @map("is_default")
  /// Inactive roles can't be assigned to new users; existing holders keep them.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  invitations     UserInvitation[]

  @@unique([tenantId, name])
  @@map("roles")
}

/// Global permission catalog — "resource:action" keys, shared by every tenant.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Many-to-many — a user may hold multiple roles (e.g. Manager + Trainer).
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

enum PermissionOverrideMode {
  GRANT
  DENY

  @@map("permission_override_mode")
}

/// Per-user permission override on top of role-derived permissions.
/// Effective set = union(role permissions) + GRANTs − DENYs.
model UserPermission {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  permissionId String                 @map("permission_id") @db.Uuid
  mode         PermissionOverrideMode @default(GRANT)
  createdAt    DateTime               @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([tenantId])
  @@map("user_permissions")
}

/// Branch access rows for users with `allBranches = false`. `expiresAt`
/// supports temporary assignments (covering staff at another location).
model UserBranch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  isPrimary Boolean   @default(false) @map("is_primary")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([tenantId])
  @@map("user_branches")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

/// Staff invitation — same token-hash pattern as PasswordReset (only the
/// SHA-256 of the invite token is stored; the plaintext goes in the email).
model UserInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  email           String           @db.VarChar(255)
  roleId          String           @map("role_id") @db.Uuid
  /// JSON array of branch ids granted on acceptance; null = all branches.
  branchIds       Json?            @map("branch_ids")
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash")
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  acceptedUserId  String?          @map("accepted_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("user_invitations")
}

/// Staff Management module (Prompt 13). Gender/employment fields for the
/// three staff types (Manager/Trainer/Receptionist) — the gym Owner already
/// exists via the OWNER role and never gets a StaffProfile row.
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("gender")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN

  @@map("employment_type")
}

enum SalaryType {
  MONTHLY
  HOURLY
  DAILY
  PER_SESSION

  @@map("salary_type")
}

/// Day-to-day work state — distinct from `User.status` (account/login
/// access). A staff member can be ACTIVE (can log in) but ON_LEAVE this week.
enum WorkStatus {
  WORKING
  ON_LEAVE
  NOTICE_PERIOD
  TERMINATED

  @@map("work_status")
}

/// 1:1 extension of `User` for staff-only fields — kept off the core User
/// model (used by every account type incl. future Members) to avoid
/// polluting it with employment data that doesn't apply tenant-wide.
/// `firstName`/`lastName` are the structured form the Staff UI edits;
/// `User.name` is kept as the derived "First Last" display string so every
/// other part of the app (auth, sessions, notifications, audit) keeps
/// working against the field it already expects.
model StaffProfile {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  /// Auto-generated on create (e.g. "EMP-0007"), editable afterward.
  employeeId     String         @map("employee_id") @db.VarChar(40)
  firstName      String         @map("first_name") @db.VarChar(80)
  lastName       String         @map("last_name") @db.VarChar(80)
  gender         Gender?
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Date
  joiningDate    DateTime       @default(now()) @map("joining_date") @db.Date
  addressLine    String?        @map("address_line") @db.VarChar(200)
  city           String?        @db.VarChar(100)
  state          String?        @db.VarChar(100)
  country        String?        @db.VarChar(100)
  postalCode     String?        @map("postal_code") @db.VarChar(20)
  notes          String?
  employmentType EmploymentType @default(FULL_TIME) @map("employment_type")
  salaryType     SalaryType     @default(MONTHLY) @map("salary_type")
  salaryAmount   Decimal?       @map("salary_amount") @db.Decimal(12, 2)
  shift          String?        @db.VarChar(60)
  /// Comma-separated weekday names, e.g. "SUNDAY" or "SUNDAY,MONDAY".
  weeklyOff      String?        @map("weekly_off") @db.VarChar(60)
  workStatus     WorkStatus     @default(WORKING) @map("work_status")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  /// Covers the staff list's `workStatus` filter (Prompt 32 perf pass).
  @@index([tenantId, workStatus])
  @@map("staff_profiles")
}

// ── Member Management (Prompt 14) ─────────────────────────────────────────
//
// A gym member is a standalone record — NOT a `User` row. Unlike staff, the
// prompt for this module has no invitation/password/login flow, so members
// don't get portal accounts here (the `MEMBER` system role + its permissions
// already seeded in Prompt 5 stay reserved for a future member-facing portal
// that would create real User rows at that time).

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN

  @@map("blood_group")
}

/// Account-level gate on check-in — distinct from `MembershipStatus`, which
/// tracks a specific membership period's lifecycle (a member can be ACTIVE
/// here while their current membership is EXPIRED, e.g. between renewals).
enum MemberStatus {
  ACTIVE
  INACTIVE
  FROZEN

  @@map("member_status")
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  /// Superseded by a renewal/upgrade — kept for Renewal History, not deleted.
  SUPERSEDED

  @@map("membership_status")
}

enum MemberDocumentType {
  IDENTITY_PROOF
  ADDRESS_PROOF
  MEDICAL_CERTIFICATE
  CONSENT_FORM
  OTHER

  @@map("member_document_type")
}

enum DurationType {
  DAYS
  WEEKS
  MONTHS
  YEARS

  @@map("duration_type")
}

/// The gym's own membership catalog (e.g. "3-Month Cardio", "Annual Gold") —
/// distinct from `SubscriptionPlan` (Prompt 7/8), which is FitCloud's plan
/// catalog for billing the TENANT, not the tenant's own members.
/// Prompt 15 (Membership Plans module) expanded this from the Prompt 14
/// scaffold with pricing/feature/rule fields — `durationDays` stays as a
/// derived display cache (recomputed from `durationValue`/`durationType` on
/// every write via a fixed day-length approximation); actual start/end date
/// math for a member's Membership always uses calendar-aware `addDuration()`
/// against `durationValue`/`durationType` directly, not this cache.
model MembershipPlan {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  name               String       @db.VarChar(120)
  /// Auto-generated on create (e.g. "PLAN-0007"), editable afterward.
  planCode           String       @map("plan_code") @db.VarChar(40)
  description        String?
  category           String?      @db.VarChar(60)
  durationValue      Int          @default(1) @map("duration_value")
  durationType       DurationType @default(MONTHS) @map("duration_type")
  /// Derived cache — see model doc comment above.
  durationDays       Int          @map("duration_days")
  price              Decimal      @db.Decimal(10, 2)
  joiningFee         Decimal      @default(0) @map("joining_fee") @db.Decimal(10, 2)
  taxPercentage      Decimal      @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  discountPercentage Decimal      @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  isActive           Boolean      @default(true) @map("is_active")
  displayOrder       Int          @default(0) @map("display_order")
  notes              String?

  // ── Plan Features ────────────────────────────────────────────────────
  /// true = every branch (present + future); false = only `accessBranchIds`.
  gymAccessAllBranches     Boolean @default(true) @map("gym_access_all_branches")
  /// JSON array of branch ids, only meaningful when `gymAccessAllBranches` is false.
  accessBranchIds          Json?   @map("access_branch_ids")
  ptSessionsIncluded       Int     @default(0) @map("pt_sessions_included")
  groupClassesIncluded     Int     @default(0) @map("group_classes_included")
  dietConsultationIncluded Boolean @default(false) @map("diet_consultation_included")
  lockerAccess             Boolean @default(false) @map("locker_access")
  guestPasses              Int     @default(0) @map("guest_passes")
  freezeAllowed            Boolean @default(true) @map("freeze_allowed")
  /// null = no cap on total freeze days while `freezeAllowed`.
  freezeDaysLimit          Int?    @map("freeze_days_limit")

  // ── Membership Rules ─────────────────────────────────────────────────
  /// Window during which this plan itself may be purchased/assigned — null
  /// on either side means no restriction. Distinct from a Membership's own
  /// start/end dates (this gates the PLAN, not a specific member's period).
  validityStart      DateTime? @map("validity_start") @db.Date
  validityEnd        DateTime? @map("validity_end") @db.Date
  gracePeriodDays    Int       @default(0) @map("grace_period_days")
  /// Days before expiry a renewal is allowed; 0 = anytime.
  renewalWindowDays  Int       @default(0) @map("renewal_window_days")
  autoRenewalAllowed Boolean   @default(true) @map("auto_renewal_allowed")
  minAge             Int?      @map("min_age")
  maxAge             Int?      @map("max_age")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, planCode])
  @@index([tenantId])
  @@index([tenantId, displayOrder])
  /// Covers `isActive` — filtered on every list call including the
  /// highest-traffic one (the Assign/Renew/Upgrade "assignable plans"
  /// dropdown); every sibling catalog (WorkoutPlan/DietPlan/Exercise/Food)
  /// already had this, this one was missed (Prompt 32 perf pass).
  @@index([tenantId, isActive])
  @@map("membership_plans")
}

model Member {
  id                       String       @id @default(uuid()) @db.Uuid
  tenantId                 String       @map("tenant_id") @db.Uuid
  /// Auto-generated on create (e.g. "MEM-0007"), editable afterward.
  memberId                 String       @map("member_id") @db.VarChar(40)
  firstName                String       @map("first_name") @db.VarChar(80)
  lastName                 String       @map("last_name") @db.VarChar(80)
  profilePhotoUrl          String?      @map("profile_photo_url")
  email                    String?      @db.VarChar(255)
  phone                    String?      @db.VarChar(20)
  gender                   Gender?
  dateOfBirth              DateTime?    @map("date_of_birth") @db.Date
  bloodGroup               BloodGroup?  @map("blood_group")
  /// Centimeters / kilograms.
  height                   Decimal?     @db.Decimal(5, 2)
  weight                   Decimal?     @db.Decimal(5, 2)
  occupation               String?      @db.VarChar(120)
  addressLine              String?      @map("address_line") @db.VarChar(200)
  city                     String?      @db.VarChar(100)
  state                    String?      @db.VarChar(100)
  country                  String?      @db.VarChar(100)
  postalCode               String?      @map("postal_code") @db.VarChar(20)
  emergencyContactName     String?      @map("emergency_contact_name") @db.VarChar(120)
  emergencyContactPhone    String?      @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelation String?      @map("emergency_contact_relation") @db.VarChar(60)
  medicalConditions        String?      @map("medical_conditions")
  allergies                String?
  fitnessGoals             String?      @map("fitness_goals")
  joiningDate              DateTime     @default(now()) @map("joining_date") @db.Date
  branchId                 String       @map("branch_id") @db.Uuid
  /// The assigned trainer is a staff User holding the TRAINER role — optional.
  trainerId                String?      @map("trainer_id") @db.Uuid
  status                   MemberStatus @default(ACTIVE)
  notes                    String?
  /// Opaque token encoded into the QR — attendance check-in (future module)
  /// looks members up by this, never by the human-editable memberId.
  qrCodeToken              String       @unique @map("qr_code_token")
  qrCodeImageUrl           String?      @map("qr_code_image_url")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  deletedAt                DateTime?    @map("deleted_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  trainer      User?               @relation("MemberTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  freezes      MembershipFreeze[]
  documents    MemberDocument[]
  attendances  Attendance[]
  workoutPlans MemberWorkoutPlan[]
  dietPlans    MemberDietPlan[]
  invoices     MemberInvoice[]
  payments     MemberPayment[]

  @@unique([tenantId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  /// Covers the default "browse all members" sort (createdAt desc) — the
  /// most common unfiltered list call had no usable index before (Prompt 32
  /// perf pass).
  @@index([tenantId, createdAt])
  /// Covers the trainer-filtered member list.
  @@index([tenantId, trainerId])
  @@map("members")
}

/// One row per membership period — renewals/upgrades create a NEW row
/// (the old one flips to SUPERSEDED) so Renewal History is just this
/// member's rows ordered by `createdAt`, no separate history table needed.
model Membership {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  memberId          String           @map("member_id") @db.Uuid
  planId            String           @map("plan_id") @db.Uuid
  startDate         DateTime         @map("start_date") @db.Date
  endDate           DateTime         @map("end_date") @db.Date
  /// Snapshot from the plan at assignment time — later plan edits don't
  /// retroactively change a membership someone already bought.
  durationDays      Int              @map("duration_days")
  priceAtAssignment Decimal          @map("price_at_assignment") @db.Decimal(10, 2)
  status            MembershipStatus @default(ACTIVE)
  autoRenew         Boolean          @default(false) @map("auto_renew")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan     MembershipPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  freezes  MembershipFreeze[]
  payments MemberPayment[]

  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@map("memberships")
}

/// Freeze History — `unfrozenAt = null` means still frozen.
model MembershipFreeze {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  memberId     String    @map("member_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid
  reason       String?
  frozenAt     DateTime  @default(now()) @map("frozen_at")
  unfrozenAt   DateTime? @map("unfrozen_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, memberId])
  @@map("membership_freezes")
}

/// Uploaded documents — same no-object-storage, inline data-URL pattern as
/// staff/avatar uploads elsewhere in this schema (see docs/BACKEND-GUIDE.md).
model MemberDocument {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  memberId    String             @map("member_id") @db.Uuid
  type        MemberDocumentType
  fileName    String             @map("file_name") @db.VarChar(200)
  fileDataUrl String             @map("file_data_url")
  uploadedAt  DateTime           @default(now()) @map("uploaded_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId])
  @@map("member_documents")
}

/// QR_CODE and MANUAL are the only methods wired up today; the device-based
/// entries exist so a future biometric/face/NFC/RFID reader integration is
/// purely additive (new enum value + a device-side caller), no schema or API
/// reshape — `deviceName`/`deviceId` on `Attendance` are already generic
/// enough to describe any of them.
enum AttendanceMethod {
  QR_CODE
  MANUAL
  BIOMETRIC
  FACE_RECOGNITION
  NFC
  RFID

  @@map("attendance_method")
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT

  @@map("attendance_status")
}

/// One row per visit. `checkOutTime = null` means the member is still
/// inside — a hand-written partial unique index (see the RLS migration)
/// guarantees at most one open row per member at the DB level, not just in
/// the service. `attendanceDate` is the check-in's calendar date in the
/// BRANCH's own timezone (`Branch.timezone`), computed once at write time so
/// history/summary queries can filter and group on a plain indexed column
/// instead of re-deriving it per row.
model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  memberId       String           @map("member_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  checkInTime    DateTime         @map("check_in_time")
  checkOutTime   DateTime?        @map("check_out_time")
  attendanceDate DateTime         @map("attendance_date") @db.Date
  method         AttendanceMethod @default(MANUAL)
  deviceName     String?          @map("device_name") @db.VarChar(120)
  deviceId       String?          @map("device_id") @db.VarChar(120)
  status         AttendanceStatus @default(CHECKED_IN)
  notes          String?
  /// Staff user who performed a MANUAL check-in/out; null for member
  /// self-service methods (QR/biometric/etc).
  checkedInBy    String?          @map("checked_in_by") @db.Uuid
  checkedOutBy   String?          @map("checked_out_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member           Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch           Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkedInByUser  User?  @relation("AttendanceCheckedInBy", fields: [checkedInBy], references: [id], onDelete: SetNull)
  checkedOutByUser User?  @relation("AttendanceCheckedOutBy", fields: [checkedOutBy], references: [id], onDelete: SetNull)

  @@index([tenantId, memberId])
  @@index([tenantId, branchId])
  @@index([tenantId, attendanceDate])
  /// Covers the default "recent attendance" sort (checkInTime desc,
  /// unbounded date range) — the most common unfiltered list call had no
  /// usable index before (Prompt 32 perf pass).
  @@index([tenantId, checkInTime])
  /// Covers the branch-scoped dashboard aggregates (countForDate/
  /// trendBetween), which filter tenantId+branchId+attendanceDate together.
  @@index([tenantId, branchId, attendanceDate])
  @@map("attendance_records")
}

enum ExerciseDifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("exercise_difficulty_level")
}

/// The gym's own exercise catalog, reused across workout plans via
/// `WorkoutPlanExercise`. Soft-deletable so a plan that already references an
/// exercise never breaks even if the catalog entry is later retired.
model Exercise {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  name                 String                  @db.VarChar(150)
  category             String?                 @db.VarChar(100)
  muscleGroup          String?                 @map("muscle_group") @db.VarChar(100)
  equipment            String?                 @db.VarChar(150)
  difficultyLevel      ExerciseDifficultyLevel @default(BEGINNER) @map("difficulty_level")
  instructions         String?
  imageUrl             String?                 @map("image_url")
  /// Reference-only — never fetched/embedded server-side, just displayed as a link.
  videoUrl             String?                 @map("video_url")
  durationSeconds      Int?                    @map("duration_seconds")
  defaultSets          Int?                    @map("default_sets")
  defaultReps          Int?                    @map("default_reps")
  restSeconds          Int?                    @map("rest_seconds")
  caloriesBurnEstimate Int?                    @map("calories_burn_estimate")
  isActive             Boolean                 @default(true) @map("is_active")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  deletedAt            DateTime?               @map("deleted_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planExercises WorkoutPlanExercise[]
  progress      MemberWorkoutProgress[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("exercises")
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("workout_level")
}

/// Day of the weekly schedule an exercise is placed on within a plan.
enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("week_day")
}

/// The gym's reusable workout-plan catalog (same shape as `MembershipPlan`
/// for memberships) — authored once, then assigned to many members via
/// `MemberWorkoutPlan`. Editing a plan's exercises later does NOT
/// retroactively change a member's already-assigned plan snapshot-in-time;
/// see `MemberWorkoutPlan` for how assignment history is preserved.
model WorkoutPlan {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  name          String       @db.VarChar(150)
  description   String?
  goal          String?      @db.VarChar(150)
  level         WorkoutLevel @default(BEGINNER)
  durationWeeks Int          @map("duration_weeks")
  /// Author/owner trainer — must be an active User holding the TRAINER role
  /// (business rule: "only active trainers can create or manage workout
  /// plans"). Optional so a Manager can author a plan with no trainer yet.
  trainerId     String?      @map("trainer_id") @db.Uuid
  isActive      Boolean      @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer   User?                 @relation("WorkoutPlanTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  exercises WorkoutPlanExercise[]
  members   MemberWorkoutPlan[]

  @@index([tenantId, isActive])
  @@index([tenantId, trainerId])
  @@map("workout_plans")
}

/// One row per exercise placed on a plan's weekly schedule. `sortOrder` is
/// the drag-and-drop ordering WITHIN one (planId, dayOfWeek) — the frontend
/// reorders items on drop and persists the whole day's new exercise order.
model WorkoutPlanExercise {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  exerciseId  String   @map("exercise_id") @db.Uuid
  dayOfWeek   WeekDay  @map("day_of_week")
  sortOrder   Int      @default(0) @map("sort_order")
  /// Per-plan overrides — fall back to the exercise's own defaults when null.
  sets        Int?
  repetitions Int?
  restSeconds Int?     @map("rest_seconds")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([tenantId, planId, dayOfWeek])
  @@map("workout_plan_exercises")
}

enum MemberWorkoutPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("member_workout_plan_status")
}

/// One row per assignment — assigning a new plan (or the same plan again)
/// while one is ACTIVE flips the old row to CANCELLED and creates a fresh
/// row, the same "supersede, never mutate" history pattern as `Membership`.
/// This is what satisfies "members can have multiple workout plans, but only
/// one active plan" and "preserve workout history after updates" together.
model MemberWorkoutPlan {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  memberId       String                  @map("member_id") @db.Uuid
  workoutPlanId  String                  @map("workout_plan_id") @db.Uuid
  assignedDate   DateTime                @default(now()) @map("assigned_date") @db.Date
  startDate      DateTime                @map("start_date") @db.Date
  endDate        DateTime?               @map("end_date") @db.Date
  status         MemberWorkoutPlanStatus @default(ACTIVE)
  trainerRemarks String?                 @map("trainer_remarks")
  memberNotes    String?                 @map("member_notes")
  assignedBy     String?                 @map("assigned_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member         Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workoutPlan    WorkoutPlan             @relation(fields: [workoutPlanId], references: [id], onDelete: Restrict)
  assignedByUser User?                   @relation("MemberWorkoutPlanAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  progress       MemberWorkoutProgress[]

  @@index([tenantId, memberId])
  @@index([tenantId, workoutPlanId])
  @@index([tenantId, status])
  @@map("member_workout_plans")
}

enum MemberExerciseProgressStatus {
  PENDING
  COMPLETED
  SKIPPED

  @@map("member_exercise_progress_status")
}

/// Per-exercise completion state for one member's plan assignment — this
/// backs "Completed Exercises"/"Skipped Exercises"/progress-percent all from
/// one table (unique per assignment+exercise; marking progress again just
/// updates the same row's status/notes/timestamp, it doesn't append rows).
model MemberWorkoutProgress {
  id                  String                       @id @default(uuid()) @db.Uuid
  tenantId            String                       @map("tenant_id") @db.Uuid
  memberWorkoutPlanId String                       @map("member_workout_plan_id") @db.Uuid
  exerciseId          String                       @map("exercise_id") @db.Uuid
  status              MemberExerciseProgressStatus @default(PENDING)
  notes               String?
  markedAt            DateTime?                    @map("marked_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberWorkoutPlan MemberWorkoutPlan @relation(fields: [memberWorkoutPlanId], references: [id], onDelete: Cascade)
  exercise          Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([memberWorkoutPlanId, exerciseId])
  @@index([tenantId, memberWorkoutPlanId])
  @@map("member_workout_progress")
}

/// The gym's own food catalog — reused across diet plans via
/// `DietPlanMeal`. Soft-deletable so a plan that already references a food
/// never breaks even if the catalog entry is later retired.
model Food {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String    @db.VarChar(150)
  category      String?   @db.VarChar(100)
  servingSize   String?   @map("serving_size") @db.VarChar(100)
  calories      Int?
  protein       Decimal?  @db.Decimal(6, 2)
  carbohydrates Decimal?  @db.Decimal(6, 2)
  fat           Decimal?  @db.Decimal(6, 2)
  fiber         Decimal?  @db.Decimal(6, 2)
  sugar         Decimal?  @db.Decimal(6, 2)
  sodium        Decimal?  @db.Decimal(7, 2)
  notes         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planMeals DietPlanMeal[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("foods")
}

/// Fixed set of daily meal slots (NOT tied to a day-of-week — a diet plan's
/// meals repeat every day of the plan, unlike a workout plan's weekly
/// schedule).
enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  EVENING_SNACK
  DINNER
  PRE_WORKOUT
  POST_WORKOUT

  @@map("meal_type")
}

/// The gym's reusable diet-plan catalog (same shape as `WorkoutPlan`) —
/// authored once, then assigned to many members via `MemberDietPlan`.
/// Editing a plan's meals later does NOT retroactively change a member's
/// already-assigned plan; see `MemberDietPlan` for how assignment history is
/// preserved.
model DietPlan {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String    @db.VarChar(150)
  description   String?
  goal          String?   @db.VarChar(150)
  dailyCalories Int?      @map("daily_calories")
  durationDays  Int       @map("duration_days")
  /// Author/owner trainer or nutritionist — must be an active User holding
  /// the TRAINER role (business rule: "only active trainers can create or
  /// assign diet plans"). Optional so a Manager can author a plan with no
  /// trainer yet.
  trainerId     String?   @map("trainer_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer User?            @relation("DietPlanTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  meals   DietPlanMeal[]
  members MemberDietPlan[]

  @@index([tenantId, isActive])
  @@index([tenantId, trainerId])
  @@map("diet_plans")
}

/// One row per food placed under a meal slot within a plan. `sortOrder` is
/// the Meal Builder's ordering WITHIN one (planId, mealType).
model DietPlanMeal {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  foodId    String   @map("food_id") @db.Uuid
  mealType  MealType @map("meal_type")
  sortOrder Int      @default(0) @map("sort_order")
  /// Serving multiplier against the food's own base serving — e.g. 1.5x.
  quantity  Decimal  @default(1) @db.Decimal(5, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   DietPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  food   Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([tenantId, planId, mealType])
  @@map("diet_plan_meals")
}

enum MemberDietPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("member_diet_plan_status")
}

/// One row per assignment — assigning a new (or the same) plan while one is
/// ACTIVE flips the old row to COMPLETED and creates a fresh row, the same
/// "supersede, never mutate" history pattern as `Membership`/`MemberWorkoutPlan`.
model MemberDietPlan {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  memberId       String               @map("member_id") @db.Uuid
  dietPlanId     String               @map("diet_plan_id") @db.Uuid
  assignedDate   DateTime             @default(now()) @map("assigned_date") @db.Date
  startDate      DateTime             @map("start_date") @db.Date
  endDate        DateTime?            @map("end_date") @db.Date
  status         MemberDietPlanStatus @default(ACTIVE)
  trainerRemarks String?              @map("trainer_remarks")
  memberNotes    String?              @map("member_notes")
  assignedBy     String?              @map("assigned_by") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member         Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dietPlan       DietPlan             @relation(fields: [dietPlanId], references: [id], onDelete: Restrict)
  assignedByUser User?                @relation("MemberDietPlanAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  dailyLogs      MemberDietDailyLog[]

  @@index([tenantId, memberId])
  @@index([tenantId, dietPlanId])
  @@index([tenantId, status])
  @@map("member_diet_plans")
}

/// One row per (assignment, calendar date) — "Daily Tracking" + "Water
/// Intake" + "Weight Tracking" all in one row, upserted by date (logging
/// again for the same date just overwrites it, it doesn't append rows).
/// `mealsStatus` is a small Json map of `MealType -> PENDING|COMPLETED|SKIPPED`
/// for that day (a normalized child table would be one row per meal slot per
/// day for no real query benefit at this scale — kept as Json deliberately).
model MemberDietDailyLog {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  memberDietPlanId String   @map("member_diet_plan_id") @db.Uuid
  date             DateTime @db.Date
  waterIntakeMl    Int?     @map("water_intake_ml")
  weightKg         Decimal? @map("weight_kg") @db.Decimal(5, 2)
  mealsStatus      Json?    @map("meals_status")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberDietPlan MemberDietPlan @relation(fields: [memberDietPlanId], references: [id], onDelete: Cascade)

  @@unique([memberDietPlanId, date])
  @@index([tenantId, memberDietPlanId])
  @@map("member_diet_daily_logs")
}

/// Gym-operations finance (charging MEMBERS) — deliberately named/mapped
/// distinctly from the platform `Payment`/`Invoice`/`PaymentMethod` models
/// above (Prompt 8, FitCloud billing THE TENANT for its own subscription).
/// Those are a completely separate concern; see the schema comments on
/// `TenantInvoiceSettings` for the same tenant-vs-platform distinction.
enum MemberPaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CHEQUE
  /// Not wired to a real gateway yet — same "ship the enum value now, wire
  /// the integration later" precedent as Attendance's BIOMETRIC/NFC/etc.
  ONLINE_GATEWAY

  @@map("member_payment_method")
}

enum MemberPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("member_payment_status")
}

enum MemberInvoiceStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED

  @@map("member_invoice_status")
}

enum IncomeCategory {
  MEMBERSHIP_FEE
  PERSONAL_TRAINING
  /// Not orderable yet — no product/inventory module exists; the category
  /// exists now so manual entries can already be classified correctly.
  PRODUCT_SALES
  OTHER

  @@map("income_category")
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  EQUIPMENT
  MAINTENANCE
  MARKETING
  OFFICE_SUPPLIES
  OTHER

  @@map("expense_category")
}

/// A bill issued TO a member. May be created standalone ("Generate Invoice",
/// status UNPAID, e.g. billing an upcoming renewal in advance) or
/// auto-generated the moment a `MemberPayment` succeeds with no invoice
/// already attached (business rule: "every successful membership payment
/// automatically generates an invoice") — see `MemberPaymentService`.
model MemberInvoice {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  invoiceNumber  String              @map("invoice_number") @db.VarChar(30)
  memberId       String              @map("member_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  invoiceDate    DateTime            @map("invoice_date") @db.Date
  dueDate        DateTime            @map("due_date") @db.Date
  subtotal       Decimal             @db.Decimal(10, 2)
  taxAmount      Decimal             @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal             @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal             @map("total_amount") @db.Decimal(10, 2)
  status         MemberInvoiceStatus @default(UNPAID)
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  branch   Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items    MemberInvoiceItem[]
  payments MemberPayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, memberId])
  @@index([tenantId, status])
  /// Covers the branch-scoped outstanding-balance dashboard aggregate
  /// (`sumOutstanding`) and the branch-filtered invoice list, neither of
  /// which had an index containing `branchId` before (Prompt 32 perf pass).
  @@index([tenantId, branchId, status])
  /// Covers the default "browse all invoices" sort (createdAt desc).
  @@index([tenantId, createdAt])
  @@map("member_invoices")
}

model MemberInvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String  @db.VarChar(200)
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice MemberInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("member_invoice_items")
}

/// One row per payment attempt/record from a member. `invoiceId` is
/// optional: if set at creation, this payment settles THAT invoice (and a
/// second successful payment against an already-settled invoice is
/// rejected — "prevent duplicate payments for the same invoice"); if left
/// unset and the payment succeeds, a new invoice is auto-generated for it.
model MemberPayment {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  paymentNumber        String              @map("payment_number") @db.VarChar(30)
  memberId             String              @map("member_id") @db.Uuid
  membershipId         String?             @map("membership_id") @db.Uuid
  invoiceId            String?             @map("invoice_id") @db.Uuid
  branchId             String              @map("branch_id") @db.Uuid
  amount               Decimal             @db.Decimal(10, 2)
  discount             Decimal             @default(0) @db.Decimal(10, 2)
  tax                  Decimal             @default(0) @db.Decimal(10, 2)
  finalAmount          Decimal             @map("final_amount") @db.Decimal(10, 2)
  method               MemberPaymentMethod
  paymentDate          DateTime            @map("payment_date") @db.Date
  transactionReference String?             @map("transaction_reference") @db.VarChar(120)
  status               MemberPaymentStatus @default(SUCCESS)
  notes                String?
  recordedBy           String?             @map("recorded_by") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member         Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership     Membership?           @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  invoice        MemberInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recordedByUser User?                 @relation("MemberPaymentRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)
  refunds        MemberPaymentRefund[]
  income         Income?

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, invoiceId])
  /// Covers the branch-scoped finance-dashboard aggregates (recent/
  /// sumFinalAmountForDateRange/dailyTotalsForRange) and the branch-filtered
  /// payment list — `branchId` was filtered in all of these with no index
  /// containing it before (Prompt 32 perf pass).
  @@index([tenantId, branchId, paymentDate])
  @@map("member_payments")
}

/// "Refunds must create financial history" — a refund is always a NEW row,
/// never a mutation/deletion of the original `MemberPayment`, so the
/// payment's full lifecycle stays visible forever. A payment can have
/// multiple partial refunds.
model MemberPaymentRefund {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?
  refundedBy String?  @map("refunded_by") @db.Uuid
  refundedAt DateTime @default(now()) @map("refunded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment        MemberPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refundedByUser User?         @relation("MemberPaymentRefundedBy", fields: [refundedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, paymentId])
  @@map("member_payment_refunds")
}

/// The gym's own revenue ledger. A `MEMBERSHIP_FEE` row is auto-created
/// whenever a `MemberPayment` succeeds (see `MemberPaymentService`,
/// `sourcePaymentId` unique — one income row per payment, never duplicated);
/// every other category is entered manually.
model Income {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  category        IncomeCategory
  amount          Decimal        @db.Decimal(10, 2)
  incomeDate      DateTime       @map("income_date") @db.Date
  branchId        String?        @map("branch_id") @db.Uuid
  description     String?
  sourcePaymentId String?        @unique @map("source_payment_id") @db.Uuid
  recordedBy      String?        @map("recorded_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sourcePayment  MemberPayment? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  recordedByUser User?          @relation("IncomeRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, category])
  @@index([tenantId, incomeDate])
  /// Covers the branch-scoped finance-dashboard aggregates, which filter
  /// tenantId+branchId+incomeDate together (Prompt 32 perf pass).
  @@index([tenantId, branchId, incomeDate])
  @@map("income_entries")
}

/// The gym's own expense ledger. Receipt upload reuses the exact
/// no-object-storage data-URL convention as `MemberDocument`.
model Expense {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  category        ExpenseCategory
  amount          Decimal         @db.Decimal(10, 2)
  expenseDate     DateTime        @map("expense_date") @db.Date
  branchId        String?         @map("branch_id") @db.Uuid
  description     String?
  receiptFileName String?         @map("receipt_file_name") @db.VarChar(200)
  receiptDataUrl  String?         @map("receipt_data_url")
  recordedBy      String?         @map("recorded_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  recordedByUser User?   @relation("ExpenseRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, category])
  @@index([tenantId, expenseDate])
  /// Covers the branch-scoped finance-dashboard aggregates, which filter
  /// tenantId+branchId+expenseDate together (Prompt 32 perf pass).
  @@index([tenantId, branchId, expenseDate])
  @@map("expenses")
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY

  @@map("report_frequency")
}

/// "Allow reports to be generated automatically for future email delivery" —
/// a persisted schedule config; the actual generation + email happens in a
/// BullMQ repeatable job (`modules/reports/jobs/scheduled-reports.jobs.ts`),
/// same pattern as `subscription-billing.jobs.ts`. `reportType` is a free
/// string validated against a fixed catalog in the zod schema rather than a
/// Prisma enum — the catalog is 18 entries long and only enforced at the API
/// boundary, not the DB.
model ScheduledReport {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  name            String          @db.VarChar(150)
  reportType      String          @map("report_type") @db.VarChar(60)
  frequency       ReportFrequency
  recipientEmails String[]        @map("recipient_emails")
  branchId        String?         @map("branch_id") @db.Uuid
  filters         Json?
  isActive        Boolean         @default(true) @map("is_active")
  lastRunAt       DateTime?       @map("last_run_at")
  nextRunAt       DateTime        @map("next_run_at")
  createdBy       String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser User?   @relation("ScheduledReportCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive, nextRunAt])
  @@map("scheduled_reports")
}

// ── Sessions & tokens ─────────────────────────────────────────────────────

/// Opaque, rotating refresh tokens. Only the SHA-256 hash is stored.
/// `family` links every token issued from one original login — reuse of a
/// replaced token revokes the whole family (theft detection).
model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  family              String    @db.Uuid
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

/// A user-visible device/session record (what "logout from this device" acts on).
/// 1:1 with the refresh token currently backing it.
model UserSession {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  refreshTokenId String?   @unique @map("refresh_token_id") @db.Uuid
  deviceLabel    String?   @map("device_label")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  lastActiveAt   DateTime  @default(now()) @map("last_active_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ── Verification & recovery ───────────────────────────────────────────────

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

/// 6-digit OTP challenges — login MFA and (future-ready) 2FA. Only the hash
/// of the code is stored; `attempts` bounds brute-forcing a single code.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  codeHash    String     @map("code_hash")
  purpose     OtpPurpose
  channel     OtpChannel @default(EMAIL)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

// ── Observability ──────────────────────────────────────────────────────────

/// Every login attempt, success or failure — durable brute-force evidence
/// alongside the fast Redis counters used for real-time lockout decisions.
model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String   @db.VarChar(255)
  success   Boolean
  reason    String?  @db.VarChar(60)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, email, createdAt])
  @@map("login_history")
}

/// Append-only trail of sensitive mutations and authorization denials.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role") @db.VarChar(60)
  action      String   @db.VarChar(80)
  entityType  String?  @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action])
  /// Covers "show this user's activity" — a common IAM detail-page query
  /// with no index at all before (Prompt 32 perf pass).
  @@index([tenantId, actorUserId])
  @@map("audit_logs")
}

// ── Platform: SaaS onboarding & subscriptions (Prompt 7) ───────────────────
//
// Everything below supports automatic tenant provisioning: the plan
// catalog, a tenant's actual subscription against that catalog, its
// subdomain (and future custom domain), branding, a starter branch,
// enabled modules, plan-derived limits, and live usage counters against
// those limits. `audit_logs` above already covers "tenant_audit_logs" —
// provisioning writes into that same table rather than a parallel one.

/// Global, tenant-agnostic plan catalog (Starter/Professional/Enterprise).
/// Seeded once (prisma/seed.ts) — tenants reference a plan, they never own one.
model SubscriptionPlan {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique @db.VarChar(40)
  name             String   @db.VarChar(80)
  description      String?
  priceMonthly     Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly      Decimal  @map("price_yearly") @db.Decimal(10, 2)
  currency         String   @default("USD") @db.Char(3)
  trialDays        Int      @default(14) @map("trial_days")
  maxBranches      Int      @map("max_branches")
  maxManagers      Int      @map("max_managers")
  maxTrainers      Int      @map("max_trainers")
  maxReceptionists Int      @default(0) @map("max_receptionists")
  maxStaff         Int      @default(0) @map("max_staff")
  maxMembers       Int      @map("max_members")
  maxStorageMb     Int      @map("max_storage_mb")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  features      SubscriptionPlanFeature[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

/// One row per feature toggle a plan grants (e.g. "chat", "custom_roles",
/// "api_access") — the checklist shown on the pricing/plan-selection step.
model SubscriptionPlanFeature {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  key       String   @db.VarChar(60)
  label     String   @db.VarChar(120)
  included  Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("subscription_features")
}

/// A tenant's actual subscription against the plan catalog — the billing
/// source of truth. `Tenant.status/trialEndsAt/subscriptionExpiresAt`
/// remain a denormalized fast-path cache the tenant middleware reads on
/// every request without a join; this table is the detailed record kept
/// in sync with it by the provisioning service and (future) billing jobs.
/// The tenant's billing record. Table name stays `subscriptions` (not the
/// literal `tenant_subscriptions` some specs use) — this is the same model
/// Prompt 7's provisioning saga already creates and depends on; renaming it
/// would break working code for a cosmetic naming difference, and this IS
/// the "one subscription per tenant" table either name would describe.
model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  couponId              String?            @map("coupon_id") @db.Uuid
  status                SubscriptionStatus @default(TRIALING)
  billingCycle          BillingCycle       @default(MONTHLY) @map("billing_cycle")
  trialEndsAt           DateTime?          @map("trial_ends_at")
  currentPeriodStart    DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd      DateTime?          @map("current_period_end")
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  /// Set when a renewal payment fails — PAST_DUE until this passes, then GRACE.
  graceEndsAt           DateTime?          @map("grace_ends_at")
  suspendedAt           DateTime?          @map("suspended_at")
  cancelledAt           DateTime?          @map("cancelled_at")
  cancelReason          String?            @map("cancel_reason")
  gatewayProvider       String?            @map("gateway_provider") @db.VarChar(20)
  gatewayCustomerId     String?            @map("gateway_customer_id")
  gatewaySubscriptionId String?            @map("gateway_subscription_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  coupon   Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  history  SubscriptionHistory[]
  payments Payment[]
  invoices Invoice[]

  @@index([tenantId])
  @@map("subscriptions")
}

/// The subdomain (and, in future, verified custom domain) a tenant is
/// reachable at. Exactly one SUBDOMAIN row per tenant is created at
/// provisioning time; CUSTOM rows are a future self-serve feature — the
/// data model supports it today (isVerified/dnsVerifiedAt gate whether a
/// custom domain is actually routable) without DNS automation being built.
model TenantDomain {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  domain        String     @unique @db.VarChar(255)
  type          DomainType @default(SUBDOMAIN)
  isPrimary     Boolean    @default(true) @map("is_primary")
  isVerified    Boolean    @default(true) @map("is_verified")
  dnsVerifiedAt DateTime?  @map("dns_verified_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

/// Visual identity — split out from TenantSettings so branding can evolve
/// (logo uploads, custom CSS) independently of operational settings.
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM

  @@map("theme_preference")
}

model TenantBranding {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @unique @map("tenant_id") @db.Uuid
  logoUrl            String?         @map("logo_url")
  faviconUrl         String?         @map("favicon_url")
  primaryColor       String          @default("oklch(0.51 0.23 277)") @map("primary_color")
  primaryForeground  String          @default("oklch(0.985 0 0)") @map("primary_foreground")
  /// Accent color for secondary actions/badges — added in Prompt 10 for the
  /// portal shell's theme; falls back to `primaryColor` at read time for
  /// tenants provisioned before this field existed.
  secondaryColor     String?         @map("secondary_color")
  welcomeMessage     String?         @map("welcome_message")
  customCss          String?         @map("custom_css")
  /// Branding module (Prompt 12) additions. `theme` is the tenant's stored
  /// preference, not yet wired as the ThemeProvider default (that mirror
  /// lives client-side via next-themes per-browser) — recorded here so the
  /// setting persists and a future prompt can apply it as the initial value.
  theme              ThemePreference @default(SYSTEM)
  loginBackgroundUrl String?         @map("login_background_url")
  dashboardBannerUrl String?         @map("dashboard_banner_url")
  emailLogoUrl       String?         @map("email_logo_url")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

/// Gym Profile, Branding & Business Settings module (Prompt 12) — the
/// gym's own business identity (legal/tax info, contact, address, hours,
/// social links). Distinct from `BillingAddress` (Prompt 8), which is the
/// address FitCloud bills the TENANT at, not the gym's own public address.
model TenantProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  legalBusinessName  String?  @map("legal_business_name") @db.VarChar(160)
  registrationNumber String?  @map("registration_number") @db.VarChar(60)
  gstVatNumber       String?  @map("gst_vat_number") @db.VarChar(40)
  businessType       String?  @map("business_type") @db.VarChar(60)
  description        String?
  email              String?  @db.VarChar(255)
  phone              String?  @db.VarChar(20)
  alternatePhone     String?  @map("alternate_phone") @db.VarChar(20)
  website            String?  @db.VarChar(255)
  addressLine        String?  @map("address_line") @db.VarChar(200)
  city               String?  @db.VarChar(100)
  state              String?  @db.VarChar(100)
  country            String?  @db.VarChar(100)
  postalCode         String?  @map("postal_code") @db.VarChar(20)
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  /// { monday: { open, close, closed }, ... } — keyed by lowercase weekday name.
  businessHours      Json?    @map("business_hours")
  /// { facebook?, instagram?, twitter?, youtube?, linkedin? }
  socialLinks        Json?    @map("social_links")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

/// The gym's OWN invoicing defaults (for future member/customer invoices) —
/// unrelated to the platform's `Invoice` model (Prompt 8), which is
/// FitCloud billing the tenant for their subscription.
model TenantInvoiceSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @unique @map("tenant_id") @db.Uuid
  invoicePrefix           String   @default("INV") @map("invoice_prefix") @db.VarChar(20)
  invoiceFooter           String?  @map("invoice_footer")
  taxPercentage           Decimal  @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  defaultPaymentTermsDays Int      @default(15) @map("default_payment_terms_days")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_invoice_settings")
}

/// The tenant's first location, created automatically at provisioning so
/// staff/member records always have somewhere to attach to. Branch
/// MANAGEMENT (create/edit/list more branches) is a future Gym module —
/// this table + the one default row are the only in-scope pieces here.
/// Prompt 22 (Branch Management) expanded this from Prompt 10's minimal
/// scaffold (name/isDefault/isActive/timezone) into the full branch record —
/// additive only, every pre-existing field/consumer (the portal's branch
/// selector, every other module's `branchId` FK) is untouched.
model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String    @db.VarChar(120)
  /// Auto-generated on create (e.g. "BR-0001"), editable afterward — same
  /// pattern as `MembershipPlan.planCode`/`Member.memberId`.
  branchCode     String    @map("branch_code") @db.VarChar(40)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  whatsappNumber String?   @map("whatsapp_number") @db.VarChar(30)
  addressLine1   String?   @map("address_line1") @db.VarChar(200)
  addressLine2   String?   @map("address_line2") @db.VarChar(200)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  postalCode     String?   @map("postal_code") @db.VarChar(20)
  latitude       Decimal?  @db.Decimal(9, 6)
  longitude      Decimal?  @db.Decimal(9, 6)
  /// { monday: {open,close,closed}, ... } — same shape as
  /// `TenantSettings.businessHours` (Prompt 12), one level down at the
  /// branch. `closed: true` doubles as "Working Days" (a day not marked
  /// closed is a working day).
  operatingHours Json?     @map("operating_hours")
  /// Array of `{date, label}` — one-off closures on top of the weekly
  /// `operatingHours` pattern. A lightweight JSON list rather than a child
  /// table since it's never queried/filtered on, only displayed/edited whole.
  holidays       Json?     @map("holidays")
  capacity       Int?
  maxMembers     Int?      @map("max_members")
  maxStaff       Int?      @map("max_staff")
  allowCheckIn   Boolean   @default(true) @map("allow_check_in")
  notes          String?
  isDefault      Boolean   @default(true) @map("is_default")
  isActive       Boolean   @default(true) @map("is_active")
  timezone       String    @default("UTC") @db.VarChar(64)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userBranches        UserBranch[]
  members             Member[]
  attendances         Attendance[]
  invoices            MemberInvoice[]
  payments            MemberPayment[]
  incomeEntries       Income[]
  expenses            Expense[]
  scheduledReports    ScheduledReport[]
  tenantAnnouncements TenantAnnouncement[]

  @@unique([tenantId, branchCode])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

/// Which app modules are switched on for a tenant — seeded from the
/// chosen plan's features at provisioning time. A future admin screen
/// could override individual toggles without changing the plan.
model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(60)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_modules")
}

/// Snapshot of the tenant's current plan limits — copied from
/// SubscriptionPlan at provisioning/plan-change time so limit checks
/// (a future PlanLimitGuard) are a single-row lookup, no join required.
model TenantLimit {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  maxBranches      Int      @map("max_branches")
  maxManagers      Int      @map("max_managers")
  maxTrainers      Int      @map("max_trainers")
  maxReceptionists Int      @default(0) @map("max_receptionists")
  maxStaff         Int      @default(0) @map("max_staff")
  maxMembers       Int      @map("max_members")
  maxStorageMb     Int      @map("max_storage_mb")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_limits")
}

/// Live usage counters against `TenantLimit` — one row per metric
/// ("branches", "managers", "trainers", "members", "storage_mb"),
/// initialized to zero (or 1, for branches — the default branch already
/// exists) at provisioning time.
model TenantUsage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  metric    String   @db.VarChar(40)
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric])
  @@map("tenant_usage")
}

// ── Platform: subscription & billing (Prompt 8) ────────────────────────────
//
// Everything below extends Prompt 7's plan/subscription foundation into a
// full billing engine: coupons, tax, invoices, payments (provider-pattern
// gateways), and the audit trail of subscription state transitions. Gym
// OPERATIONS billing (charging members) is a separate, future concern —
// this is exclusively the platform charging the gym owner (tenant) for
// their FitCloud subscription.

/// Append-only trail of every subscription state/plan transition — what
/// the lifecycle diagram (Trial → Active → Renewal Due → Grace →
/// Suspended → Reactivated → Cancelled → Expired) actually did, and why.
model SubscriptionHistory {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id") @db.Uuid
  subscriptionId String                    @map("subscription_id") @db.Uuid
  fromPlanId     String?                   @map("from_plan_id") @db.Uuid
  toPlanId       String?                   @map("to_plan_id") @db.Uuid
  fromStatus     SubscriptionStatus?       @map("from_status")
  toStatus       SubscriptionStatus        @map("to_status")
  action         SubscriptionHistoryAction
  note           String?
  createdAt      DateTime                  @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("subscription_history")
}

/// One row per tenant — used for invoice "bill to" details and tax
/// jurisdiction lookup (country/state feed `TaxRule`).
model BillingAddress {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @unique @map("tenant_id") @db.Uuid
  legalName  String?  @map("legal_name") @db.VarChar(160)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String   @db.VarChar(100)
  state      String   @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(20)
  country    String   @db.VarChar(2)
  taxId      String?  @map("tax_id") @db.VarChar(40)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_addresses")
}

/// Flat rate lookup by country (+ optional state/province) — enough for a
/// single consolidated tax line per invoice without a full tax-jurisdiction
/// engine. `stateCode = null` is a country-wide fallback rate.
model TaxRule {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(2)
  stateCode   String?  @map("state_code") @db.VarChar(10)
  label       String   @db.VarChar(80)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([countryCode, stateCode])
  @@map("tax_rules")
}

/// A discount code. `type` determines which of percentOff/amountOff/
/// trialExtensionDays applies; `scope` distinguishes a single-use code from
/// one meant to apply every renewal (RECURRING) or handed out for referrals.
model Coupon {
  id                      String      @id @default(uuid()) @db.Uuid
  code                    String      @unique @db.VarChar(40)
  type                    CouponType
  scope                   CouponScope @default(ONE_TIME)
  percentOff              Decimal?    @map("percent_off") @db.Decimal(5, 2)
  amountOff               Decimal?    @map("amount_off") @db.Decimal(10, 2)
  currency                String?     @db.Char(3)
  trialExtensionDays      Int?        @map("trial_extension_days")
  maxRedemptions          Int?        @map("max_redemptions")
  maxRedemptionsPerTenant Int         @default(1) @map("max_redemptions_per_tenant")
  timesRedeemed           Int         @default(0) @map("times_redeemed")
  expiresAt               DateTime?   @map("expires_at")
  isActive                Boolean     @default(true) @map("is_active")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  redemptions   CouponRedemption[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("coupons")
}

/// One row per tenant-redemption — enforces `maxRedemptionsPerTenant`
/// (usually 1) independently of the coupon's global `maxRedemptions`.
model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("coupon_redemptions")
}

/// Platform-wide gateway configuration/toggle — NOT per-tenant. All tenants
/// pay FitCloud through whichever gateways are enabled here; a tenant never
/// brings their own gateway account. `config` holds non-secret routing
/// details only (secrets belong in env/secret-manager, never this table).
model PaymentGateway {
  id        String                 @id @default(uuid()) @db.Uuid
  provider  PaymentGatewayProvider @unique
  isEnabled Boolean                @default(true) @map("is_enabled")
  config    Json                   @default("{}")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@map("payment_gateways")
}

/// A tenant's saved, tokenized payment method (card/UPI/etc.) — only the
/// gateway's own token + display metadata are stored, never raw card data.
model PaymentMethod {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  provider          PaymentGatewayProvider
  gatewayCustomerId String?                @map("gateway_customer_id")
  gatewayMethodId   String                 @map("gateway_method_id")
  brand             String?                @db.VarChar(30)
  last4             String?                @db.VarChar(4)
  expiryMonth       Int?                   @map("expiry_month")
  expiryYear        Int?                   @map("expiry_year")
  isDefault         Boolean                @default(false) @map("is_default")
  createdAt         DateTime               @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payment_methods")
}

/// One logical charge attempt. `idempotencyKey` is supplied by the caller
/// (checkout/renewal job) so a retried request can never double-charge —
/// the unique constraint makes a duplicate insert fail closed, not silently
/// succeed twice.
model Payment {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  subscriptionId   String?                @map("subscription_id") @db.Uuid
  invoiceId        String?                @unique @map("invoice_id") @db.Uuid
  provider         PaymentGatewayProvider
  status           PaymentStatus          @default(PENDING)
  amount           Decimal                @db.Decimal(10, 2)
  currency         String                 @db.Char(3)
  idempotencyKey   String                 @unique @map("idempotency_key")
  gatewayReference String?                @map("gateway_reference")
  failureReason    String?                @map("failure_reason")
  /// Non-sensitive gateway metadata only (card brand/last4 already live on
  /// PaymentMethod) — encrypted at rest via the column-level pgcrypto
  /// convention documented in docs/architecture/ARCHITECTURE.md §9, not
  /// re-derived here since this environment has no real gateway secrets.
  metadata         Json                   @default("{}")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice      Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([tenantId, createdAt])
  @@map("payments")
}

/// Raw gateway event log backing a Payment — every webhook delivery and
/// gateway API response, kept verbatim for reconciliation/dispute evidence,
/// independent of whatever `Payment.status` was derived from it.
model PaymentTransaction {
  id             String                 @id @default(uuid()) @db.Uuid
  paymentId      String                 @map("payment_id") @db.Uuid
  provider       PaymentGatewayProvider
  eventType      String                 @map("event_type") @db.VarChar(60)
  rawPayload     Json                   @map("raw_payload")
  signatureValid Boolean                @map("signature_valid")
  processedAt    DateTime?              @map("processed_at")
  createdAt      DateTime               @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}

/// A billable document — one per checkout/renewal charge. `subtotal -
/// discountAmount + taxAmount = total`; `items` gives the line-level
/// breakdown (plan charge, proration, etc.).
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  couponId       String?       @map("coupon_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(40)
  status         InvoiceStatus @default(OPEN)
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @db.Char(3)
  dueDate        DateTime?     @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payment      Payment?

  @@index([tenantId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String   @db.VarChar(200)
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ── Platform: Super Admin portal (Prompt 9) ────────────────────────────────
//
// A completely separate authority plane from tenant users — its own
// identity table, its own RBAC catalog, its own JWT audience (see
// core/security/admin-jwt.service.ts). None of these tables carry RLS:
// there is no "tenant" to isolate by here, only a single internal SaaS-
// operator organization. Cross-tenant reads elsewhere in this schema (e.g.
// `Tenant`, `Subscription`) are exactly what this portal exists to query.

enum AdminUserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("admin_user_status")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum AnnouncementAudience {
  ALL
  TRIAL
  ACTIVE
  SPECIFIC

  @@map("announcement_audience")
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP

  @@map("notification_channel")
}

enum CmsPageType {
  LANDING
  BLOG
  FAQ
  TESTIMONIAL
  TERMS
  PRIVACY
  COOKIE

  @@map("cms_page_type")
}

/// SUPER_ADMIN/SUPPORT_ADMIN/FINANCE_ADMIN/CONTENT_ADMIN/TECHNICAL_ADMIN are
/// seeded system roles; anything else created from the portal is a custom role.
model AdminRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(60)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions AdminRolePermission[]
  adminUsers      AdminUser[]

  @@map("admin_roles")
}

/// Global permission catalog for the admin portal ("resource:action" keys) —
/// deliberately a separate catalog from the tenant `permissions` table, since
/// "tenants:manage" here means something an ordinary gym Owner must never hold.
model AdminPermission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

/// A SaaS-operator staff account — completely distinct from tenant `User`.
model AdminUser {
  id                  String          @id @default(uuid()) @db.Uuid
  roleId              String          @map("role_id") @db.Uuid
  name                String          @db.VarChar(120)
  email               String          @unique @db.VarChar(255)
  passwordHash        String          @map("password_hash")
  status              AdminUserStatus @default(ACTIVE)
  mfaEnabled          Boolean         @default(false) @map("mfa_enabled")
  mfaSecret           String?         @map("mfa_secret")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  lastLoginAt         DateTime?       @map("last_login_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")

  role            AdminRole           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens   AdminRefreshToken[]
  auditLogs       AdminAuditLog[]
  assignedTickets SupportTicket[]     @relation("TicketAssignee")
  ticketNotes     SupportTicketNote[]

  @@map("admin_users")
}

/// Mirrors the tenant `RefreshToken` rotation/reuse-detection design, scoped
/// to admin sessions and signed under a different JWT audience entirely.
model AdminRefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  adminUserId         String    @map("admin_user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  family              String    @db.Uuid
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([family])
  @@map("admin_refresh_tokens")
}

/// Admin-portal audit trail — login/logout, tenant changes, subscription/
/// payment changes, system settings changes, admin activity. Separate from
/// the tenant `audit_logs` table (different actor identity: AdminUser, not
/// tenant User).
model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String?  @map("admin_user_id") @db.Uuid
  actorRole   String?  @map("actor_role") @db.VarChar(60)
  action      String   @db.VarChar(80)
  entityType  String?  @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("admin_audit_logs")
}

/// Key-value system configuration (SMTP, SMS gateway, payment gateway keys,
/// storage provider, Cloudflare/AWS/Redis/queue settings, maintenance mode).
/// `value` is `Json` so heterogeneous config shapes share one table instead
/// of a column-per-setting migration every time a new integration is added.
model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  category  String   @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Global module toggles (Attendance, Workout, Diet, Reports, Analytics,
/// Chat, Inventory, POS, White Label, Custom Domain, + future-ready Video
/// Training/AI Coach/Marketplace) — distinct from per-tenant `TenantModule`
/// (which reflects what a tenant's PLAN grants); this is a platform-wide
/// kill switch above that, e.g. to disable a module while it's unstable.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(60)
  label     String   @db.VarChar(120)
  category  String?  @db.VarChar(60)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Landing page content, blogs, FAQs, testimonials, and legal pages — one
/// table, `type` distinguishes them; `content` is `Json` (rich structured
/// content) rather than a single text blob so the CMS can evolve per type.
model CmsPage {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique @db.VarChar(160)
  type        CmsPageType
  title       String      @db.VarChar(200)
  content     Json
  isPublished Boolean     @default(false) @map("is_published")
  publishedAt DateTime?   @map("published_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("cms_pages")
}

/// `tenantId` is nullable — a ticket can come from a prospective customer
/// (marketing site contact form) with no tenant yet, not only existing gyms.
model SupportTicket {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String?        @map("tenant_id") @db.Uuid
  subject         String         @db.VarChar(200)
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  assignedAdminId String?        @map("assigned_admin_id") @db.Uuid
  createdByEmail  String         @map("created_by_email") @db.VarChar(255)
  createdByName   String?        @map("created_by_name") @db.VarChar(120)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  closedAt        DateTime?      @map("closed_at")

  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignedAdmin AdminUser?          @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  notes         SupportTicketNote[]

  @@index([status, priority])
  /// Covers the tenant portal's ticket list (`WHERE tenantId [AND status]
  /// ORDER BY createdAt`) — the old lone `[tenantId]` index couldn't serve
  /// the status filter or the sort; superseded by this composite, whose
  /// leftmost-prefix (`tenantId` alone) still covers every use the old
  /// index did (Prompt 32 perf pass). `[status, priority]` above stays
  /// as-is — it serves the separate cross-tenant admin queue view.
  @@index([tenantId, status, createdAt])
  @@map("support_tickets")
}

/// `isInternal = true` notes are staff-only (never shown to the tenant) —
/// the ticket detail view's equivalent of a private comment thread.
model SupportTicketNote {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @map("ticket_id") @db.Uuid
  authorAdminId String   @map("author_admin_id") @db.Uuid
  note          String
  isInternal    Boolean  @default(true) @map("is_internal")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAdmin AdminUser     @relation(fields: [authorAdminId], references: [id], onDelete: Restrict)

  @@map("support_ticket_notes")
}

/// A one-way broadcast banner shown inside every tenant portal (not a
/// per-recipient inbox — see `Notification` for that).
model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       String               @db.VarChar(200)
  body        String
  audience    AnnouncementAudience @default(ALL)
  isActive    Boolean              @default(true) @map("is_active")
  publishedAt DateTime?            @map("published_at")
  expiresAt   DateTime?            @map("expires_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("announcements")
}

/// A scheduled/sent global message — email, push, or in-app — distinct from
/// `Announcement`'s persistent banner: this is a one-time dispatch tracked
/// through `scheduledAt`/`sentAt`, queued the same way onboarding/billing
/// emails are (see infrastructure/queue).
model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  title       String               @db.VarChar(200)
  body        String
  channel     NotificationChannel  @default(EMAIL)
  audience    AnnouncementAudience @default(ALL)
  scheduledAt DateTime?            @map("scheduled_at")
  sentAt      DateTime?            @map("sent_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@map("notifications")
}

model Country {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(2)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  @@map("countries")
}

model Currency {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(3)
  name     String  @db.VarChar(60)
  symbol   String  @db.VarChar(8)
  isActive Boolean @default(true) @map("is_active")

  @@map("currencies")
}

/// Admin-managed template CATALOG — subject/body/variables are editable
/// from the portal. NOTE (scope boundary, documented not hidden): the actual
/// send paths built in Prompts 5/7/8 (auth-templates.ts, onboarding-
/// templates.ts, billing-templates.ts) still use their own hardcoded TS
/// template functions; wiring every existing send call site to fetch from
/// this table instead is a follow-up, not done here. This table lets the
/// portal manage template CONTENT today without that larger rewire.
model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(80)
  subject   String   @db.VarChar(200)
  bodyHtml  String   @map("body_html")
  variables Json     @default("[]")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model SmsTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(80)
  body      String
  variables Json     @default("[]")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sms_templates")
}

// ── Platform: Tenant Portal foundation (Prompt 10) ─────────────────────────

enum TenantNotificationCategory {
  ANNOUNCEMENT
  SYSTEM
  SUBSCRIPTION
  GENERAL
  /// Added in Prompt 21 (Notifications & Communication) for the new
  /// business-event triggers — additive, existing values/rows untouched.
  MEMBER
  MEMBERSHIP
  PAYMENT
  ATTENDANCE
  WORKOUT
  DIET
  STAFF

  @@map("tenant_notification_category")
}

/// The Notification Center's data source — one row per item a tenant's
/// staff sees (unread/read tracked here, at the TENANT level rather than
/// per-user, since a shared front-desk login is common for gyms; this is a
/// deliberate v1 simplification, not an oversight). Populated by:
///   • admin broadcast Notifications fanning out to matching tenants
///     (see admin-notifications module's `send()`)
///   • subscription lifecycle events (trial ending, payment failed/
///     succeeded, grace period, expired) — written alongside the existing
///     billing emails, not replacing them
/// `sourceNotificationId` links back to the admin `Notification` row when
/// this was a broadcast, for traceability; null for system-generated ones.
model TenantNotification {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @map("tenant_id") @db.Uuid
  category             TenantNotificationCategory @default(GENERAL)
  title                String                     @db.VarChar(200)
  body                 String
  sourceNotificationId String?                    @map("source_notification_id") @db.Uuid
  readAt               DateTime?                  @map("read_at")
  createdAt            DateTime                   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tenant_notifications")
}

enum TenantAnnouncementAudience {
  ALL
  MEMBERS
  STAFF

  @@map("tenant_announcement_audience")
}

enum TenantAnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED

  @@map("tenant_announcement_status")
}

/// Prompt 21 — in-gym announcements a Manager/Owner authors and publishes to
/// their own members/staff (rich-text body from the frontend editor). This is
/// a DIFFERENT concept from the pre-existing `Announcement` model (a global,
/// admin-authored platform banner broadcast from the super-admin plane down
/// to matching tenants by subscription status) — same naming-collision
/// avoidance precedent as Finance's `MemberPayment` vs. the platform's
/// `Payment` model. Publishing (immediate or via the scheduler sweep) also
/// writes a `TenantNotification` row with category `ANNOUNCEMENT` so it shows
/// up in the same Notification Center feed as everything else.
model TenantAnnouncement {
  id          String                     @id @default(uuid()) @db.Uuid
  tenantId    String                     @map("tenant_id") @db.Uuid
  branchId    String?                    @map("branch_id") @db.Uuid
  title       String                     @db.VarChar(200)
  body        String
  audience    TenantAnnouncementAudience @default(ALL)
  status      TenantAnnouncementStatus   @default(DRAFT)
  publishAt   DateTime?                  @map("publish_at")
  publishedAt DateTime?                  @map("published_at")
  expiresAt   DateTime?                  @map("expires_at")
  createdBy   String                     @map("created_by") @db.Uuid
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser User    @relation("TenantAnnouncementCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("tenant_announcements")
}

enum NotificationTemplateType {
  MEMBERSHIP_EXPIRY
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  MEMBERSHIP_RENEWAL
  NEW_MEMBER_REGISTRATION
  ATTENDANCE_CONFIRMATION
  WORKOUT_ASSIGNMENT
  DIET_ASSIGNMENT
  WELCOME_MESSAGE
  BIRTHDAY_WISHES

  @@map("notification_template_type")
}

/// Channels a template can fire through. Named `TenantNotificationChannel`
/// (not bare `NotificationChannel`, which is already a platform-plane enum
/// on the admin-side `Notification` model with a different value set) — same
/// naming-collision avoidance precedent as `TenantNotification` itself. Only
/// IN_APP and EMAIL are actually wired up in this pass — PUSH/SMS are
/// "(Future)" per the spec, and WHATSAPP is included now purely so the
/// architecture doesn't need another migration to add it later (same "ship
/// the enum value now" precedent as MemberPayment's ONLINE_GATEWAY method).
enum TenantNotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WHATSAPP

  @@map("tenant_notification_channel")
}

/// Per-tenant override of the 10 built-in notification templates. A missing
/// row for a given `type` means "use the hardcoded default" (see
/// `modules/tenant-notifications/constants/default-templates.ts`) — rows are
/// only created here when a tenant actually customizes one, not seeded
/// up front for every tenant.
model NotificationTemplate {
  id            String                      @id @default(uuid()) @db.Uuid
  tenantId      String                      @map("tenant_id") @db.Uuid
  type          NotificationTemplateType
  channels      TenantNotificationChannel[]
  titleTemplate String                      @map("title_template") @db.VarChar(200)
  bodyTemplate  String                      @map("body_template")
  isActive      Boolean                     @default(true) @map("is_active")
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@map("notification_templates")
}
