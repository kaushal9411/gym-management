<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only exception to Android's default cleartext-HTTP block
  (targetSdk 28+ rejects plain http:// at the OS level with no app-visible
  error beyond a generic connection failure — this is what was behind
  "Can't reach FitCloud" even once the USB port-forward/tunnel was
  confirmed working). Scoped to the addresses Env.apiBaseUrl actually
  resolves to during local development (see lib/core/env.dart) — the
  release/profile manifests don't get this file at all, so a production
  build stays on the platform default (HTTPS-only).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
