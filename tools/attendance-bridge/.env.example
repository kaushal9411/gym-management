# The tenant's own subdomain API URL — same one tenant-web/mobile use, NOT
# a global/shared URL (the device authenticates by X-Device-Key, which is
# only valid against this one tenant). Always include /api/v1.
API_BASE_URL=https://your-gym.fitcloud.app/api/v1

# From Settings -> Attendance Devices -> Register device (tenant-web). Shown
# exactly once at creation/regeneration — paste it here immediately.
DEVICE_API_KEY=

# Only ZKTECO ships today (see src/adapters/zkteco.adapter.ts).
DEVICE_VENDOR=ZKTECO
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370

# How often to poll the device for new punches, in milliseconds.
POLL_INTERVAL_MS=15000

# Local file tracking which punches were already forwarded, so a bridge
# restart doesn't re-send (and double-toggle check-in/check-out for) old
# punches. Safe to delete if you want a clean resync.
CURSOR_FILE=.cursor.json
