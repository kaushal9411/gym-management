{
  "name": "gym-saas-platform",
  "version": "0.0.0",
  "private": true,
  "description": "FitCloud — multi-tenant gym management SaaS platform (Turborepo monorepo)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "audit": "pnpm audit --audit-level=high",
    "test:a11y": "playwright test --config=e2e/playwright.config.ts",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.8"
  }
}
