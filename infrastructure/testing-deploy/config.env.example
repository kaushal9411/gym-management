# Copy this to config.env and fill in. config.env is gitignored — it ends up
# holding an S3 bucket name and instance details, nothing secret by itself,
# but keep it out of version control anyway.
#
# Requires: AWS CLI v2 configured (`aws configure`) with an IAM user/role
# that can create S3 buckets/IAM users, EC2 instances, security groups, and
# Elastic IPs. Free-tier account is enough — nothing here requires anything
# beyond what a personal AWS account already has.

# ── AWS ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── S3 (set by 01-setup-s3.sh, read by 03-deploy-app.sh) ───────────────────
S3_BUCKET=fitcloud-test-uploads
IAM_USER_NAME=fitcloud-test-app

# ── EC2 (set by 02-launch-ec2.sh, read by 03-deploy-app.sh) ────────────────
INSTANCE_NAME=fitcloud-test
# t3.micro — the only sizes covered by AWS's free tier (750 hrs/month, free
# for 12 months on a new/eligible account) are t2.micro/t3.micro. Anything
# bigger (t3.small etc.) bills against your card, even with credit left.
# 1GB RAM is tight for Postgres+Redis+3 Node apps — 02-launch-ec2.sh adds a
# 2GB swap file on the instance so builds don't OOM.
INSTANCE_TYPE=t3.micro
KEY_NAME=fitcloud-test-key
SECURITY_GROUP_NAME=fitcloud-test-sg
# Leave blank to auto-detect your current public IP for SSH access.
SSH_CIDR=

# ── Custom domain (optional — 04-setup-domain.sh) ───────────────────────
# Leave all three blank to keep using the sslip.io address from
# 02-launch-ec2.sh. Fill in once you've pointed real DNS A records (and a
# wildcard on PLATFORM_HOSTNAME) at your Elastic IP.
API_HOSTNAME=
ADMIN_HOSTNAME=
PLATFORM_HOSTNAME=
